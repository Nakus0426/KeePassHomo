import { FileUtil } from '@pura/harmony-utils'

// 附件图标按扩展名分桶：同族格式先共用一张图，缺图标的格式落到「未知类型」。
export function fileTypeIcon(fileName: string): Resource {
  switch (FileUtil.getFileExtention(fileName).toLowerCase()) {
    case 'pdf':
      return $r('app.media.file_type_pdf')
    case 'doc':
    case 'docx':
    case 'odt':
    case 'rtf':
    case 'wps':
    case 'pages':
      return $r('app.media.file_type_doc')
    case 'xls':
    case 'xlsx':
    case 'csv':
    case 'ods':
    case 'et':
    case 'numbers':
      return $r('app.media.file_type_xls')
    case 'ppt':
    case 'pptx':
    case 'odp':
    case 'dps':
    case 'key':
      return $r('app.media.file_type_ppt')
    case 'ofd':
      return $r('app.media.file_type_ofd')
    case 'jpg':
    case 'jpeg':
      return $r('app.media.file_type_jpg')
    case 'png':
      return $r('app.media.file_type_png')
    case 'webp':
      return $r('app.media.file_type_webp')
    case 'gif':
    case 'bmp':
    case 'svg':
    case 'heic':
    case 'heif':
    case 'tif':
    case 'tiff':
    case 'ico':
    case 'avif':
      return $r('app.media.file_type_gif')
    case 'mp3':
    case 'wav':
    case 'm4a':
    case 'aac':
    case 'ogg':
    case 'flac':
    case 'wma':
    case 'opus':
    case 'amr':
    case 'mid':
    case 'midi':
      return $r('app.media.file_type_mp3')
    case 'mp4':
    case 'mkv':
    case 'mov':
    case 'avi':
    case 'webm':
    case 'ts':
    case 'flv':
    case 'wmv':
    case 'm4v':
    case 'mpg':
    case 'mpeg':
    case '3gp':
    case 'rmvb':
      return $r('app.media.file_type_mp4')
    case 'md':
    case 'markdown':
      return $r('app.media.file_type_md')
    case 'txt':
    case 'log':
    case 'ini':
    case 'conf':
    case 'json':
    case 'xml':
    case 'html':
    case 'htm':
    case 'css':
    case 'js':
    case 'ts':
    case 'py':
    case 'java':
    case 'c':
    case 'cpp':
    case 'h':
    case 'sh':
    case 'yml':
    case 'yaml':
    case 'sql':
      return $r('app.media.file_type_txt')
    default:
      return $r('app.media.file_type_unknown')
  }
}
